{
    "name": "koishi-plugin-logger-next",
    "description": "Dump log files for Koishi",
    "version": "0.4.3",
    "type": "module",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "dist",
        "client",
        "src"
    ],
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dingyi222666/koishi-plugin-logger-next.git"
    },
    "homepage": "https://github.com/dingyi222666/koishi-plugin-logger-next",
    "bugs": {
        "url": "https://github.com/dingyi222666/koishi-plugin-logger-next/issues"
    },
    "keywords": [
        "bot",
        "chatbot",
        "koishi",
        "plugin",
        "logs",
        "logger"
    ],
    "koishi": {
        "public": [
            "dist"
        ],
        "description": {
            "en": "Dump log files and show them in the console.",
            "zh": "保存日志文件并在控制台中显示。"
        },
        "service": {
            "optional": [
                "console"
            ]
        }
    },
    "peerDependencies": {
        "@koishijs/plugin-console": "^5.30.10",
        "koishi": "^4.18.9"
    },
    "peerDependenciesMeta": {
        "@koishijs/plugin-console": {
            "optional": true
        }
    },
    "devDependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@koishijs/client": "^5.30.11",
        "@koishijs/plugin-console": "^5.30.10",
        "ansi_up": "^5.2.1",
        "element-plus": "^2.7.7",
        "esbuild": "^0.25.10",
        "esbuild-register": "npm:@shigma/esbuild-register@^1.1.1",
        "koishi": "^4.18.9",
        "reggol": "^1.7.1",
        "typescript": "^5.4.5",
        "vue": "^3.4.21",
        "yakumo": "^1.0.0",
        "yakumo-esbuild": "^1.0.0",
        "yakumo-tsc": "^1.0.0"
    },
    "dependencies": {
        "@koishijs/console": "^5.30.10"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "yarn yakumo build",
        "bump": "yarn yakumo version",
        "dep": "yarn yakumo upgrade",
        "pub": "yarn yakumo publish",
        "lint": "yarn eslint src --ext=ts",
        "lint-fix": "yarn eslint src --ext=ts --fix"
    }
}
